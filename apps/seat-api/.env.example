# ============================================================
# 图书馆自习座位智能预约系统 - 环境变量示例
# 复制为 .env 后填入实际值
# ============================================================

# ---------- 数据库 (MySQL) ----------
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
DB_DATABASE=seat_reserve
# 生产环境建议设为 false，首次部署时可 true 自动建表
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ---------- Redis ----------
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT ----------
# 生产环境务必换一个强随机字符串
JWT_SECRET=your-256-bit-secret-key-here
JWT_EXPIRES_IN=7d

# ---------- MQTT (Aedes Broker) ----------
# Railway 上内嵌 Aedes 不需要改，或填 ws://0.0.0.0:1883
MQTT_BROKER=mqtt://0.0.0.0:1883
MQTT_CLIENT_ID=nestjs-server

# ---------- 微信小程序 ----------
# 在 https://mp.weixin.qq.com 获取
WECHAT_APPID=wx...
WECHAT_APP_SECRET=...

# ---------- 应用 ----------
PORT=3000
NODE_ENV=production
